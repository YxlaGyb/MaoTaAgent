{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "packages/*/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "eggshell/eggshell.ts",
    "eggshell/eggshell.smoke.ts",
    "eggshell/conversation.smoke.ts"
, "apps/web/tests/web.smoke.ts", "packages/plugin-kit/src/plugins.check.ts"  ]
}
