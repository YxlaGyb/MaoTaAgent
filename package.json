{
  "name": "@maota/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "i18n/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node node_modules/eggshell-kernel/install.js",
    "build": "tsdown",
    "check": "node scripts/check.ts",
    "check:types": "pnpm build && tsc --noEmit",
    "check:plugins": "node packages/boot/app-boot/src/plugins.check.ts",
    "check:config": "node apps/cli/lib/index.js check",
    "boot": "node apps/cli/lib/index.js",
    "cli:smoke": "node apps/cli/tests/cli.smoke.ts",
    "bridge:smoke": "node packages/boot/host/tests/bridge.smoke.ts",
    "conversation:smoke": "node scripts/tests/conversation.smoke.ts",
    "hooks-e2e:smoke": "node scripts/tests/hooks.smoke.ts",
    "agent:smoke": "node packages/agent/agent-core/tests/agent.smoke.ts",
    "api:smoke": "node packages/api/tests/api.smoke.ts",
    "tools:smoke": "node packages/agent/tools/tests/tools.smoke.ts",
    "loop:smoke": "node packages/agent/agent-loop/tests/loop.smoke.ts",
    "i18n:smoke": "node i18n/i18n-native/tests/i18n.smoke.ts",
    "i18n-protocol:smoke": "node i18n/i18n-protocol/tests/i18n.smoke.ts",
    "hooks:smoke": "node packages/hooks/hooks-native/tests/hooks.smoke.ts",
    "fs:smoke": "node packages/fs/fs/tests/fs.smoke.ts",
    "tool-fs:smoke": "node packages/fs/tool-fs/tests/tool-fs.smoke.ts",
    "tool-fs-search:smoke": "node packages/fs/tool-fs-search/tests/tool-fs-search.smoke.ts",
    "tool-todo:smoke": "node packages/todo/tool-todo/tests/tool-todo.smoke.ts",
    "tool-pwsh:smoke": "node packages/shell/tool-pwsh/tests/tool-pwsh.smoke.ts",
    "session:smoke": "node packages/session/tests/session.smoke.ts",
    "permission:smoke": "node packages/interaction/permission/tests/permission.smoke.ts",
    "tool-subagent:smoke": "node packages/subagent/tool-subagent/tests/tool-subagent.smoke.ts",
    "skill:smoke": "node packages/skill/skill/tests/skill.smoke.ts",
    "skill-filesystem:smoke": "node packages/skill/skill-filesystem/tests/skill-filesystem.smoke.ts",
    "skill-bundled:smoke": "node packages/skill/skill-bundled/tests/skill-bundled.smoke.ts",
    "tool-skill:smoke": "node packages/skill/tool-skill/tests/tool-skill.smoke.ts",
    "subagent:smoke": "node scripts/tests/subagent.smoke.ts",
    "pwsh-local:smoke": "node packages/shell/pwsh-local/tests/pwsh-local.smoke.ts",
    "shell:smoke": "node packages/shell/shell/tests/shell.smoke.ts",
    "config:smoke": "node packages/boot/app-boot/tests/config.smoke.ts",
    "hmr:smoke": "node scripts/tests/hmr.smoke.ts",
    "i18n:write": "node docs/i18n.check.ts --write",
    "web": "node apps/cli/src/index.ts serve",
    "web:build": "pnpm -C apps/web build",
    "web:smoke": "node apps/web/tests/web.smoke.ts"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@maota/agent-core": "workspace:^",
    "@maota/i18n-native": "workspace:^",
    "@maota/i18n-protocol": "workspace:^",
    "@maota/api": "workspace:^",
    "@maota/base": "workspace:^",
    "@maota/hmr": "workspace:^",
    "@maota/hook-protocol": "workspace:^",
    "@maota/hooks-native": "workspace:^",
    "@maota/host": "workspace:^",
    "@maota/plugin-kit": "workspace:^",
    "@maota/permission": "workspace:^",
    "@maota/pwsh-local": "workspace:^",
    "@maota/session": "workspace:^",
    "@maota/skill": "workspace:^",
    "@maota/skill-bundled": "workspace:^",
    "@maota/skill-filesystem": "workspace:^",
    "@maota/system-prompt": "workspace:^",
    "@maota/tool-fs": "workspace:^",
    "@maota/tool-fs-search": "workspace:^",
    "@maota/tool-pwsh": "workspace:^",
    "@maota/tool-skill": "workspace:^",
    "@maota/tool-subagent": "workspace:^",
    "@maota/tool-todo": "workspace:^",
    "@maota/tools": "workspace:^",
    "@maota/web": "workspace:^",
    "@maota/web-bundle": "workspace:^",
    "@types/node": "^22.20.2",
    "eggshell-kernel": "link:..\\eggshellmod\\npm",
    "tsdown": "^0.23.0"
  }
}
