{
  "name": "MaoTaAgent",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/eggshell-kernel/install.js && pnpm -C apps/web install",
    "check": "tsc --noEmit && node docs/i18n.check.ts && node packages/plugin-kit/src/config-keys.check.ts && node packages/plugin-kit/src/plugins.check.ts && pnpm -C apps/web check",
    "check:types": "tsc --noEmit",
    "check:plugins": "node packages/plugin-kit/src/plugins.check.ts",
    "check:config": "node apps/cli/src/main.ts check",
    "boot": "node apps/cli/src/main.ts",
    "cli:smoke": "node apps/cli/tests/cli.smoke.ts",
    "smoke": "node packages/boot/host/tests/bridge.smoke.ts",
    "conversation": "node tests/conversation.smoke.ts",
    "i18n:write": "node docs/i18n.check.ts --write",
    "web": "node apps/cli/src/main.ts serve",
    "web:build": "pnpm -C apps/web build",
    "web:smoke": "node apps/web/tests/web.smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "eggshell-kernel": "link:..\\eggshellmod\\npm"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
